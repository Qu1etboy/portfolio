---
// Renders Markdown/MDX images as a <figure> with the alt text as a caption.
// Wired via `<Content components={{ img: Figure }} />` in the thought page.
interface Props {
  src: string;
  alt?: string;
}

const { src, alt } = Astro.props;
---

<figure>
  <img src={src} alt={alt ?? ""} />
  {alt && <figcaption>{alt}</figcaption>}
</figure>

<style>
  figure {
    margin: 1.5rem 0;
  }
  figcaption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.85rem;
    opacity: 0.7;
  }
</style>
