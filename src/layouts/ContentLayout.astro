---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  date: Date;
  description: string;
  readingTime?: number;
  ogImage?: string;
}

const { title, date, description, readingTime, ogImage } = Astro.props;

const isoDate = date.toISOString().split("T")[0];
const displayDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  name: title,
  description,
  datePublished: isoDate,
  author: {
    "@type": "Person",
    name: "Non",
    jobTitle: "Backend Software Engineer",
  },
};
---

<Layout title={`${title} — Non`} description={description} jsonLd={jsonLd} ogImage={ogImage}>
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-0.5 bg-accent z-50"
    style="width:0"
    aria-hidden="true"
  >
  </div>

  <article>
    <nav class="mb-10">
      <a
        href="/thoughts"
        class="group inline-flex items-center gap-1.5 font-mono text-sm text-muted hover:text-accent transition-colors duration-150"
      >
        <span class="inline-block transition-transform duration-150 group-hover:-translate-x-0.5">←</span>
        Thoughts
      </a>
    </nav>

    <header class="mb-12">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted mb-5">
        <time datetime={isoDate}>{displayDate}</time>
        {readingTime && (
          <>
            <span class="text-accent mx-2">·</span>{readingTime} min read
          </>
        )}
      </p>

      <h1
        class="font-display font-semibold tracking-tight text-balance text-[clamp(2.2rem,6vw,3.4rem)] leading-[1.05] mb-5"
      >
        {title}
      </h1>

      <p class="font-serif text-muted text-xl leading-snug text-pretty mb-8">
        {description}
      </p>

      <div
        class="flex items-center gap-3 font-mono text-sm text-muted pb-8 border-b border-line"
      >
        <span
          class="grid place-items-center w-8 h-8 rounded-full border border-line text-accent text-xs"
          aria-hidden="true"
        >N</span>
        <span>Non — Weerawong V.</span>
      </div>
    </header>

    <div class="prose prose-neutral max-w-none">
      <slot />
    </div>
  </article>

  <div
    id="lightbox"
    class="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview"
    aria-hidden="true"
    tabindex="-1"
  >
    <img id="lightbox-img" alt="" />
  </div>
</Layout>

<script>
  const bar = document.getElementById("reading-progress");
  if (bar) {
    let ticking = false;
    const update = () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + "%";
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style is:global>
  /* Prose images are clickable to enlarge */
  .prose img {
    cursor: zoom-in;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(26, 26, 23, 0.82);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    cursor: zoom-out;
    transition: opacity 0.2s ease;
  }
  .lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    border-radius: 0.5rem;
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.5);
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none;
    }
  }
</style>

<script>
  // Click (or Enter/Space) a post image to open it in a lightbox; Esc or a
  // click anywhere closes it. Progressive enhancement — no JS, images just sit.
  const box = document.getElementById("lightbox");
  const boxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  if (box && boxImg) {
    let lastTrigger: HTMLElement | null = null;

    const open = (img: HTMLImageElement) => {
      boxImg.src = img.currentSrc || img.src;
      boxImg.alt = img.alt || "";
      box.classList.add("is-open");
      box.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      lastTrigger = img;
      box.focus();
    };
    const close = () => {
      box.classList.remove("is-open");
      box.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      boxImg.removeAttribute("src");
      lastTrigger?.focus();
      lastTrigger = null;
    };

    document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
      img.setAttribute("tabindex", "0");
      img.setAttribute("role", "button");
      img.setAttribute("aria-label", "Enlarge image");
      img.addEventListener("click", () => open(img));
      img.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          open(img);
        }
      });
    });

    box.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && box.classList.contains("is-open")) close();
    });
  }
</script>
