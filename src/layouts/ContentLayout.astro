---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  date: Date;
  description: string;
  readingTime?: number;
  ogImage?: string;
}

const { title, date, description, readingTime, ogImage } = Astro.props;

const isoDate = date.toISOString().split("T")[0];
const displayDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  name: title,
  description,
  datePublished: isoDate,
  author: {
    "@type": "Person",
    name: "Non",
    jobTitle: "Backend Software Engineer",
  },
};
---

<Layout title={`${title} — Non`} description={description} jsonLd={jsonLd} ogImage={ogImage}>
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-0.5 bg-accent z-50"
    style="width:0"
    aria-hidden="true"
  >
  </div>

  <article>
    <nav class="mb-10">
      <a
        href="/thoughts"
        class="group inline-flex items-center gap-1.5 font-mono text-sm text-muted hover:text-accent transition-colors duration-150"
      >
        <span class="inline-block transition-transform duration-150 group-hover:-translate-x-0.5">←</span>
        Thoughts
      </a>
    </nav>

    <header class="mb-12">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted mb-5">
        <time datetime={isoDate}>{displayDate}</time>
        {readingTime && (
          <>
            <span class="text-accent mx-2">·</span>{readingTime} min read
          </>
        )}
      </p>

      <h1
        class="font-display font-semibold tracking-tight text-balance text-[clamp(2.2rem,6vw,3.4rem)] leading-[1.05] mb-5"
      >
        {title}
      </h1>

      <p class="font-serif text-muted text-xl leading-snug text-pretty mb-8">
        {description}
      </p>

      <div
        class="flex items-center gap-3 font-mono text-sm text-muted pb-8 border-b border-line"
      >
        <span
          class="grid place-items-center w-8 h-8 rounded-full border border-line text-accent text-xs"
          aria-hidden="true"
        >N</span>
        <span>Non — Weerawong V.</span>
      </div>
    </header>

    <div class="prose prose-neutral max-w-none">
      <slot />
    </div>
  </article>

  <div class="mt-10">
    <a
      href="/thoughts"
      class="group inline-flex items-center gap-1.5 font-mono text-sm text-muted hover:text-accent transition-colors duration-150"
    >
      <span class="inline-block transition-transform duration-150 group-hover:-translate-x-0.5">←</span>
      Back to Thoughts
    </a>
  </div>

  <div
    id="lightbox"
    class="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Preview"
    aria-hidden="true"
    tabindex="-1"
  >
    <div id="lightbox-content" class="lightbox-content"></div>
  </div>
</Layout>

<script>
  const bar = document.getElementById("reading-progress");
  if (bar) {
    let ticking = false;
    const update = () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + "%";
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style is:global>
  /* Prose images and mermaid diagrams are clickable to enlarge */
  .prose img,
  .prose .mermaid {
    cursor: zoom-in;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(26, 26, 23, 0.82);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    cursor: zoom-out;
    transition: opacity 0.2s ease;
  }
  .lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  /* Paper panel keeps transparent SVGs (mermaid) legible on the dark overlay */
  .lightbox-content {
    max-width: 92vw;
    max-height: 88vh;
    overflow: auto;
    cursor: default;
  }
  /* Paper panel only for transparent SVGs (mermaid); images go edge-to-edge */
  .lightbox-content.panel {
    background: #faf9f7;
    padding: 1.25rem;
    border-radius: 0.75rem;
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.5);
  }
  .lightbox-content img {
    display: block;
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    border-radius: 0.5rem;
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.5);
  }
  .lightbox-content svg {
    display: block;
    width: min(88vw, 1400px);
    height: auto;
    max-height: 82vh;
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none;
    }
  }
</style>

<script>
  // Click (or Enter/Space) a post image OR mermaid diagram to enlarge it in a
  // lightbox; Esc or a backdrop click closes. Click delegation handles mermaid,
  // whose SVG renders asynchronously. Progressive enhancement — no JS, no zoom.
  const box = document.getElementById("lightbox");
  const content = document.getElementById("lightbox-content");
  const article = document.querySelector("article");
  if (box && content && article) {
    let lastTrigger: HTMLElement | null = null;

    const open = (node: Element, trigger: HTMLElement) => {
      const clone = node.cloneNode(true) as HTMLElement;
      ["tabindex", "role", "aria-label", "data-zoomable"].forEach((a) =>
        clone.removeAttribute(a),
      );
      const isSvg = clone.tagName.toLowerCase() === "svg";
      if (isSvg) {
        // let CSS size it up instead of mermaid's inline dimensions
        clone.removeAttribute("width");
        clone.removeAttribute("height");
        clone.style.maxWidth = "none";
      }
      content.classList.toggle("panel", isSvg);
      content.replaceChildren(clone);
      box.classList.add("is-open");
      box.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      lastTrigger = trigger;
      box.focus();
    };
    const close = () => {
      box.classList.remove("is-open");
      box.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      content.replaceChildren();
      lastTrigger?.focus();
      lastTrigger = null;
    };

    // Click delegation — fires whether or not mermaid has rendered yet.
    article.addEventListener("click", (e) => {
      const target = e.target as Element;
      const img = target.closest(".prose img");
      if (img) return open(img, img as HTMLElement);
      const mer = target.closest(".prose .mermaid");
      const svg = mer?.querySelector("svg");
      if (mer && svg) open(svg, mer as HTMLElement);
    });

    // Keyboard: make images (now) and diagrams (once rendered) focusable buttons.
    const enhance = (el: Element) => {
      if (el.hasAttribute("data-zoomable")) return;
      el.setAttribute("data-zoomable", "1");
      el.setAttribute("tabindex", "0");
      el.setAttribute("role", "button");
      el.setAttribute("aria-label", "Enlarge");
      el.addEventListener("keydown", (e) => {
        const ev = e as KeyboardEvent;
        if (ev.key === "Enter" || ev.key === " ") {
          ev.preventDefault();
          open(el.querySelector("svg") || el, el as HTMLElement);
        }
      });
    };
    article.querySelectorAll(".prose img").forEach(enhance);
    const mo = new MutationObserver(() => {
      article
        .querySelectorAll(".prose .mermaid")
        .forEach((m) => m.querySelector("svg") && enhance(m));
    });
    mo.observe(article, { childList: true, subtree: true });

    content.addEventListener("click", (e) => e.stopPropagation());
    box.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && box.classList.contains("is-open")) close();
    });
  }
</script>
