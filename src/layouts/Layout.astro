---
interface Props {
  title: string;
  description?: string;
  jsonLd?: object;
  ogImage?: string;
}

const {
  title,
  description = "Non — backend software engineer specializing in Go.",
  jsonLd,
  ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://qu1etboy.dev");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Bricolage Grotesque (headings), Newsreader (reading body), JetBrains Mono (labels/code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}

    <title>{title}</title>

    <style is:global>
      mark {
        background-color: rgba(63, 79, 160, 0.16); /* accent @ 16% */
        color: inherit;
        padding: 0 0.15em;
        border-radius: 2px;
      }
    </style>
  </head>
  <body class="bg-paper text-ink font-serif antialiased dark:bg-ink dark:text-paper">
    <div class="max-w-prose mx-auto px-4">
      <header class="pt-16 pb-8">
        <nav aria-label="Site navigation">
          <a href="/" class="font-mono text-sm hover:text-accent transition-colors duration-150">qu1etboy.dev</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="border-t border-line mt-24 pt-10 pb-16">
        <nav aria-label="Social links" class="flex flex-col gap-3 text-sm font-mono sm:flex-row sm:gap-8">
            <a
              href="https://github.com/qu1etboy"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-fit items-center gap-2.5 text-muted hover:text-accent transition-colors duration-150"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="shrink-0" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 5 18 5.3 18 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
              github
            </a>
            <a
              href="https://x.com/WeerawongNon"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-fit items-center gap-2.5 text-muted hover:text-accent transition-colors duration-150"
            >
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" class="shrink-0" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              twitter
            </a>
            <a
              href="https://linkedin.com/in/weerawong"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-fit items-center gap-2.5 text-muted hover:text-accent transition-colors duration-150"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="shrink-0" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0z"/></svg>
              linkedin
            </a>
        </nav>
      </footer>
    </div>
  </body>
</html>
