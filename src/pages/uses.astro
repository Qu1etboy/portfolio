---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Uses — Non"
  description="The hardware and tools Non uses daily for coding and downtime."
>
  <article>
    <header class="mb-12">
      <h1 class="text-xl font-medium">/uses</h1>
    </header>

    <div class="space-y-10 text-base leading-relaxed">
      <section aria-labelledby="coding-heading">
        <h2 id="coding-heading" class="font-mono text-sm opacity-60 mb-4">coding</h2>
        <ul class="space-y-2 list-none">
          <li><a href="https://www.apple.com/macbook-pro/" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-60 transition-opacity duration-150">MacBook</a> — primary development machine</li>
        </ul>
      </section>

      <section aria-labelledby="downtime-heading">
        <h2 id="downtime-heading" class="font-mono text-sm opacity-60 mb-4">downtime</h2>
        <ul class="space-y-2 list-none">
          <li>PC — personal desktop for gaming and heavy workloads</li>
          <li><a href="https://www.playstation.com/en-us/ps5/" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-60 transition-opacity duration-150">PS5</a> — story-driven games exclusively</li>
        </ul>
      </section>

      <section aria-labelledby="input-heading">
        <h2 id="input-heading" class="font-mono text-sm opacity-60 mb-4">input</h2>
        <ul class="space-y-2 list-none">
          <li><a href="https://nuphy.com/collections/in-stock-keyboards/products/nuphy-air75-v3" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-60 transition-opacity duration-150">NuPhy Air75 V3</a></li>
          <li><a href="https://www.logitech.com/en-us/products/mice/mx-master-4.html" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-60 transition-opacity duration-150">Logitech MX Master 4</a></li>
        </ul>
      </section>
    </div>
  </article>
</Layout>
