---
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const entries = (await getCollection("papers")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Papers — Non" description="System design whitepaper summaries and technical deep-dives.">
  <article>
    <header class="mb-12">
      <h1 class="text-xl font-medium">/papers</h1>
    </header>

    {entries.length === 0 ? (
      <p class="font-mono text-sm opacity-60">No entries yet.</p>
    ) : (
      <ul class="space-y-6 list-none">
        {entries.map((entry) => {
          const isoDate = entry.data.date.toISOString().split("T")[0];
          const displayDate = entry.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
            timeZone: "UTC",
          });
          return (
            <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6">
              <time datetime={isoDate} class="font-mono text-sm opacity-60 shrink-0">
                {displayDate}
              </time>
              <a
                href={`/papers/${entry.slug}`}
                class="hover:opacity-60 transition-opacity duration-150"
              >
                {entry.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </article>
</Layout>
